# Copy to .env and fill in. Never commit .env.
JOBSCOUT_DATABASE_URL=postgresql+asyncpg://jobscout:jobscout@localhost:5432/jobscout
JOBSCOUT_REDIS_URL=redis://localhost:6379/0

# Identifies this crawler to job boards (hh.ru requires a non-empty HH-User-Agent).
# Use an app name plus a contact you are fine publishing, e.g. "JobScout/0.1 (ops@your-domain)".
JOBSCOUT_USER_AGENT=JobScout/0.1 (+https://github.com/AlidarxD/job-scout)

# Optional: hh.ru OAuth application token (raises rate limits).
JOBSCOUT_HH_TOKEN=

# Optional: LinkedIn via Apify actor (pay-per-use). Leave empty to disable the source.
JOBSCOUT_APIFY_TOKEN=
JOBSCOUT_APIFY_LINKEDIN_ACTOR=worldunboxer~rapid-linkedin-scraper

# Optional: LLM extraction. Without a key the rule-based extractor is used.
JOBSCOUT_ANTHROPIC_API_KEY=
JOBSCOUT_LLM_MODEL=claude-haiku-5-5

# Optional: Telegram bot for match notifications (planned). Put the token only here / in CI secrets.
JOBSCOUT_TELEGRAM_BOT_TOKEN=
